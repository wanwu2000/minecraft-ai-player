{
  "schemaVersion": 1,
  "id": "aiplayer",
  "name": "Minecraft AI Player",
  "version": "${mod_version}",
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/wanwu2000/minecraft-ai-player",
    "issues": "https://github.com/wanwu2000/minecraft-ai-player/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.aiplayer.AiPlayerMod"
    ],
    "client": [
      "com.aiplayer.client.AiPlayerClient"
    ]
  },
  "mixins": [
    "aiplayer.mixins.json",
    {
      "config": "aiplayer.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric": ">=0.100.0",
    "minecraft": "~1.21",
    "java": ">=21"
  },
  "recommends": {
    "meteorclient": ">=1.21"
  }
}
